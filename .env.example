# Export these values before running a benchmark. This file is an example only;
# FluxFold does not implicitly read .env files or commit provider credentials.

FLUXFOLD_GENERATION_MODEL=gpt-4.1-mini
FLUXFOLD_GENERATION_API_KEY=
FLUXFOLD_GENERATION_BASE_URL=https://api.openai.com/v1

FLUXFOLD_EMBEDDING_MODEL=text-embedding-3-small
FLUXFOLD_EMBEDDING_DIMENSION=1536
FLUXFOLD_EMBEDDING_REVISION=unspecified
FLUXFOLD_EMBEDDING_API_KEY=
FLUXFOLD_EMBEDDING_BASE_URL=https://api.openai.com/v1
FLUXFOLD_EMBEDDING_QUERY_MODE=plain
FLUXFOLD_EMBEDDING_DOCUMENT_MODE=plain
