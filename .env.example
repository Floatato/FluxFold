# Copy to .env and fill the empty values. Do not commit .env.

# Write path: extraction, linking, review, and split.
FLUXFOLD_BUILD_MODEL=gpt-4.1-mini
FLUXFOLD_BUILD_API_KEY=
FLUXFOLD_BUILD_BASE_URL=https://api.openai.com/v1

# Benchmark QA answering after public search.
FLUXFOLD_ANSWER_MODEL=gpt-4.1-mini
FLUXFOLD_ANSWER_API_KEY=
FLUXFOLD_ANSWER_BASE_URL=https://api.openai.com/v1

# LLM judge used by score.
FLUXFOLD_SCORE_MODEL=gpt-4.1-mini
FLUXFOLD_SCORE_API_KEY=
FLUXFOLD_SCORE_BASE_URL=https://api.openai.com/v1

FLUXFOLD_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
FLUXFOLD_EMBEDDING_DIMENSION=1024
FLUXFOLD_EMBEDDING_REVISION=unspecified
FLUXFOLD_EMBEDDING_API_KEY=
FLUXFOLD_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
FLUXFOLD_EMBEDDING_QUERY_MODE=Instruct: Retrieve relevant memories and topic names that help answer the query\nQuery:{text}
FLUXFOLD_EMBEDDING_DOCUMENT_MODE=plain
